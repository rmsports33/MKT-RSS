# MKT Flow 3.0 — .env.example (copie para .env e preencha)
# Nunca commitar .env — este arquivo é só documentação

# === LLM (Groq) — obrigatório para geração ===
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_COST_PER_1K_INPUT=0.00015
GROQ_COST_PER_1K_OUTPUT=0.00075

# === WordPress — obrigatório para P0 publicação ===
WP_URL=https://seusite.com
WP_USER=seu_usuario_wp
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx

# === Google Drive — opcional (para upload de artigos) ===
GOOGLE_DRIVE_CLIENT_ID=715451970554-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# === Google Sheets — opcional (para pipeline comparativo) ===
GOOGLE_SHEETS_ID=1AbCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SHEETS_CREDENTIALS=credentials.json

# === Google Analytics 4 — opcional (medir cliques nas landings) ===
# Obtenha em: https://analytics.google.com → Administrador → Fluxo de dados → ID de medição
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# === Turso (dedup na nuvem) — opcional local, obrigatório no Actions ===
# Sem os dois, o dedup usa SQLite local. Com os dois, usa Turso via HTTP
# (sem driver nativo — funciona em qualquer Python). Ver docs/NUVEM_SETUP.md
TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxx

# === Sistema ===
CREDIT_SYSTEM_ENABLED=false
DAILY_CREDIT_LIMIT=10
LOG_LEVEL=INFO
CONTEXT_TOKEN_BUDGET=2000

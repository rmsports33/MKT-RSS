/*
Theme Name: ConexoTech
Theme URI: https://conexotech.com.br
Author: ConexoTech
Author URI: https://conexotech.com.br
Description: Tema editorial do ConexoTech — reviews independentes, comparativos justos e notícias diárias de tecnologia. Identidade de revista + pesquisa técnica, 100% responsivo.
Version: 1.3.0
Requires at least: 6.0
Tested up to: 6.8
Requires PHP: 7.4
License: GNU General Public License v2 or later
License URI: https://www.gnu.org/licenses/gpl-2.0.html
Text Domain: conexotech
Tags: tecnologia, reviews, notícias, responsivo, editorial
*/

/* ============ TOKENS ============ */
:root{
  --paper:#FFFFFF;
  --wash:#F4F6F8;
  --ink:#0B1220;
  --ink-2:#101A30;
  --text:#1A1F2B;
  --muted:#5A6472;
  --faint:#8A94A3;
  --line:#E2E7EE;
  --rule:#0B1220;
  --accent:#1D4ED8;
  --lime:#A3E635;
  --lime-soft:#EFFBCE;
  --good:#15803D;
  --bad:#B91C1C;
  --serif:'Source Serif 4',Georgia,'Times New Roman',serif;
  --sans:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  --grot:'Space Grotesk','Inter',system-ui,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--sans);color:var(--text);background:var(--paper);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
img{max-width:100%;height:auto}
.wrap{max-width:1180px;margin:0 auto;padding:0 22px}
.mono{font-family:var(--mono)}
.screen-reader-text{border:0;clip:rect(1px,1px,1px,1px);clip-path:inset(50%);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;word-wrap:normal}

/* ============ BARRA / MASTHEAD ============ */
.utility{border-bottom:1px solid var(--line);font-size:.76rem;color:var(--muted)}
.utility .wrap{display:flex;justify-content:space-between;align-items:center;min-height:36px;gap:12px;padding-top:6px;padding-bottom:6px}
.utility nav ul{display:flex;gap:18px;list-style:none}
.utility a{text-decoration:none}
.utility a:hover{color:var(--ink)}
.masthead .wrap{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-top:22px;padding-bottom:20px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand-name{font-family:var(--grot);font-weight:700;font-size:2rem;letter-spacing:-.03em;line-height:1;color:var(--ink)}
.brand-name em{font-style:normal;color:var(--accent)}
.brand-sub{font-family:var(--mono);font-size:.62rem;letter-spacing:.28em;color:var(--muted);margin-top:5px;display:block}
.week-score{border:2px solid var(--rule);padding:10px 18px;display:flex;align-items:center;gap:14px;background:var(--paper);text-decoration:none}
.week-score .n{font-family:var(--mono);font-weight:700;font-size:1.9rem;line-height:1}
.week-score .t{font-size:.72rem;line-height:1.45;color:var(--muted)}
.week-score .t b{display:block;color:var(--ink);font-size:.8rem}
.mainnav{border-top:2px solid var(--rule);border-bottom:1px solid var(--rule);background:var(--paper)}
.mainnav .wrap{display:flex;align-items:center;justify-content:space-between;min-height:52px;gap:12px}
.mainnav ul.links,.mainnav ul.menu{display:flex;gap:28px;list-style:none;margin:0}
.mainnav ul.links a,.mainnav ul.menu a{text-decoration:none;font-weight:600;font-size:.9rem;padding:14px 0;display:inline-block}
.mainnav ul.links a:hover,.mainnav ul.menu a:hover,.mainnav .current-menu-item a{color:var(--accent)}
.btn{display:inline-flex;align-items:center;gap:8px;border:0;cursor:pointer;text-decoration:none;font-weight:700;font-size:.9rem;padding:13px 24px;border-radius:6px;transition:background .2s,transform .12s;font-family:var(--sans)}
.btn:active{transform:scale(.98)}
.btn-ink{background:var(--ink);color:#fff}
.btn-ink:hover{background:#1c2942}
.btn-line{background:transparent;color:var(--ink);border:2px solid var(--rule)}
.btn-line:hover{background:var(--ink);color:#fff}
.btn-sm{padding:9px 18px;font-size:.82rem}
.btn-lime{background:var(--lime);color:#1a2e05}
.btn-lime:hover{box-shadow:0 8px 20px rgba(163,230,53,.35)}
.crumbs{font-size:.76rem;color:var(--muted);margin-bottom:14px;font-family:var(--mono)}
.crumbs a{color:var(--muted);text-decoration:none}
.crumbs a:hover{color:var(--accent)}
.crumbs .separator{margin:0 8px;color:var(--faint)}
.hamburger{display:none;background:none;border:0;cursor:pointer;padding:12px 10px}
.hamburger span{display:block;width:24px;height:2px;background:var(--ink);margin:5px 0}

/* ============ TICKER ============ */
.ticker{background:var(--ink);color:#fff}
.ticker .wrap{display:flex;align-items:center;gap:14px;min-height:42px;padding-top:6px;padding-bottom:6px}
.tick-label{font-family:var(--mono);font-size:.68rem;font-weight:700;letter-spacing:.2em;color:var(--ink);background:var(--lime);padding:5px 12px;flex:none}
.tick-label i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ink);margin-right:7px;animation:blink 1.6s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
#tick-text{font-size:.85rem;color:#D7DEE8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:opacity .3s;margin:0}
#tick-text.fade{opacity:0}

/* ============ HERO ============ */
.kicker{font-family:var(--mono);font-size:.72rem;font-weight:700;letter-spacing:.22em;color:var(--accent);text-transform:uppercase}
.kicker .dot{color:var(--faint);margin:0 8px}
.hero{padding:54px 0 20px}
.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:56px;margin-top:18px;align-items:start}
.hero h1{font-family:var(--serif);font-weight:900;font-size:clamp(2.3rem,4.6vw,3.7rem);line-height:1.04;letter-spacing:-.015em;margin:14px 0 18px}
.hero h1 .u{box-shadow:inset 0 -.14em 0 var(--lime)}
.lede{font-family:var(--serif);font-size:1.22rem;line-height:1.55;color:#2b3444}
.byline{display:flex;align-items:center;gap:13px;margin:24px 0;padding:16px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--line)}
.avatar{flex:none;width:46px;height:46px;border-radius:50%;background:var(--ink);color:var(--lime);font-family:var(--mono);font-weight:700;font-size:.85rem;display:flex;align-items:center;justify-content:center;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
.byline .who{font-size:.86rem;line-height:1.5}
.byline .who b{display:block;font-size:.92rem}
.byline .who span{color:var(--muted)}
.byline time{margin-left:auto;font-family:var(--mono);font-size:.72rem;color:var(--muted);text-align:right;line-height:1.7;flex:none}
.lab-title{font-family:var(--mono);font-size:.7rem;font-weight:700;letter-spacing:.22em;color:var(--muted);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.lab-title::after{content:"";flex:1;height:1px;background:var(--line)}
.meter{margin-bottom:13px}
.meter .row{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:.84rem;margin-bottom:5px}
.meter .row b{font-weight:600}
.meter .row .v{font-family:var(--mono);font-weight:700;font-size:.82rem;white-space:nowrap}
.meter .track{height:8px;background:var(--wash);border:1px solid var(--line)}
.meter .fill{display:block;height:100%;width:0;background:var(--ink);transition:width 1.1s cubic-bezier(.2,.7,.2,1)}
.meter.top .fill{background:var(--accent)}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.hero-photo{position:relative}
.ph{position:relative;overflow:hidden;background:linear-gradient(135deg,#101A30,#1D4ED8);display:block}
.ph::after{content:attr(data-ph);position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.8rem;letter-spacing:.35em;color:rgba(255,255,255,.55)}
.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.hero-photo .ph{aspect-ratio:4/4.4;border:1px solid var(--line)}
.stamp{position:absolute;left:-34px;bottom:36px;width:128px;height:128px;filter:drop-shadow(0 10px 18px rgba(11,18,32,.3))}
.stamp svg{width:100%;height:100%;animation:spin 26s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.photocredit{font-size:.74rem;color:var(--faint);margin-top:10px;display:flex;gap:8px}
.photocredit::before{content:"";flex:none;width:22px;height:1px;background:var(--faint);margin-top:11px}
.verdict-strip{display:grid;grid-template-columns:1fr 1fr;border:2px solid var(--rule);margin-top:44px}
.verdict-strip>div{padding:26px 30px}
.verdict-strip>div+div{border-left:2px solid var(--rule)}
.verdict-strip h3{font-family:var(--mono);font-size:.72rem;letter-spacing:.22em;margin-bottom:14px}
.pros h3{color:var(--good)}
.cons h3{color:var(--bad)}
.verdict-strip ul{list-style:none;display:flex;flex-direction:column;gap:11px;font-size:.94rem}
.verdict-strip li{display:flex;gap:11px;line-height:1.5}
.verdict-strip li::before{flex:none;font-family:var(--mono);font-weight:700}
.pros li::before{content:"+";color:var(--good)}
.cons li::before{content:"–";color:var(--bad)}
.verdict-line{border:2px solid var(--rule);border-top:0;background:var(--lime-soft);padding:20px 30px;font-family:var(--serif);font-size:1.12rem;line-height:1.55}
.verdict-line b{font-family:var(--mono);font-size:.7rem;letter-spacing:.22em;display:block;margin-bottom:8px;color:var(--ink)}

/* ============ SEÇÕES ============ */
section.block{padding:70px 0}
section.block.tint{background:var(--wash)}
.sec-top{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:30px;flex-wrap:wrap}
.sec-top h2{font-family:var(--serif);font-weight:900;font-size:clamp(1.7rem,3vw,2.4rem);letter-spacing:-.01em;line-height:1.1;margin-top:10px}
.sec-top .sub{color:var(--muted);margin-top:8px;max-width:38rem}
.link-more{font-weight:700;font-size:.88rem;color:var(--accent);text-decoration:none;border-bottom:2px solid var(--accent);padding-bottom:2px;white-space:nowrap}
.link-more:hover{background:var(--accent);color:#fff}

/* ============ RANKING ============ */
.rank-row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(215px,1fr);gap:0;border:2px solid var(--rule);overflow-x:auto;background:var(--paper)}
.rank-item{padding:22px;border-right:1px solid var(--line);text-decoration:none;min-width:215px;transition:background .2s}
.rank-item:last-child{border-right:0}
.rank-item:hover{background:var(--wash)}
.rank-item .pos{font-family:var(--serif);font-weight:900;font-size:2.6rem;line-height:1;color:var(--line)}
.rank-item .ph{aspect-ratio:16/10;margin:12px 0}
.rank-item h3{font-size:.95rem;line-height:1.4}
.rank-item .sc{font-family:var(--mono);font-weight:700;font-size:.82rem;margin-top:8px;display:block}
.rank-item .sc b{background:var(--ink);color:var(--lime);padding:2px 9px;margin-right:8px}
.rank-note{font-family:var(--mono);font-size:.72rem;color:var(--muted);margin-top:12px;letter-spacing:.04em}

/* ============ REVIEWS ============ */
.tabs{display:flex;gap:26px;border-bottom:2px solid var(--rule);margin-bottom:8px;flex-wrap:wrap}
.tab{background:none;border:0;cursor:pointer;font-family:var(--sans);font-weight:700;font-size:.92rem;color:var(--muted);padding:12px 2px;position:relative}
.tab:hover{color:var(--ink)}
.tab.active{color:var(--ink)}
.tab.active::after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:4px;background:var(--lime)}
.review-row{display:grid;grid-template-columns:300px 1fr auto;gap:28px;padding:30px 0;border-bottom:1px solid var(--line);align-items:center}
.review-row .ph{aspect-ratio:16/10.5;border:1px solid var(--line)}
.review-row h3{font-family:var(--serif);font-weight:700;font-size:1.45rem;line-height:1.25;margin:8px 0 10px}
.review-row h3 a{text-decoration:none}
.review-row h3 a:hover{color:var(--accent)}
.review-row p{color:var(--muted);font-size:.94rem;max-width:40rem}
.review-row p b{color:var(--text)}
.review-meta{display:flex;gap:14px;align-items:center;margin-top:12px;font-size:.78rem;color:var(--faint);flex-wrap:wrap}
.scorebox{text-align:center;border:2px solid var(--rule);padding:14px 20px;flex:none}
.scorebox b{font-family:var(--mono);font-size:2rem;display:block;line-height:1}
.scorebox span{font-family:var(--mono);font-size:.62rem;letter-spacing:.2em;color:var(--muted)}
.scorebox.gold{background:var(--ink);border-color:var(--ink);color:#fff}
.scorebox.gold b{color:var(--lime)}
.scorebox.gold span{color:#9FB0C6}

/* ============ COMPARATIVO ============ */
.table-wrap{overflow-x:auto;border:2px solid var(--rule);background:var(--paper)}
table.comp{width:100%;border-collapse:collapse;min-width:680px}
table.comp th,table.comp td{padding:15px 18px;font-size:.9rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
table.comp thead th{background:var(--paper);border-bottom:2px solid var(--rule);vertical-align:bottom}
table.comp thead th:first-child{font-family:var(--mono);font-size:.68rem;letter-spacing:.2em;color:var(--muted);font-weight:700}
.phead{display:flex;gap:13px;align-items:center}
.phead .ph{width:66px;height:66px;flex:none;border:1px solid var(--line);border-radius:4px}
.phead b{font-family:var(--serif);font-size:1.02rem;display:block;line-height:1.3}
.phead .mono{font-size:.7rem;color:var(--muted)}
table.comp tbody th{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);background:var(--wash);white-space:nowrap;width:170px}
td.cell-win{background:var(--lime-soft);box-shadow:inset 3px 0 0 var(--good);font-weight:700}
.wintag{display:inline-block;font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.14em;color:var(--good);border:1px solid var(--good);padding:2px 8px;margin-left:9px;vertical-align:2px;white-space:nowrap}
.nota{font-family:var(--mono);font-weight:700;font-size:1.3rem}
.bar{height:7px;background:#E7ECF2;margin-top:9px;min-width:120px}
.bar i{display:block;height:100%;width:0;background:var(--ink);transition:width 1s ease}
td.cell-win .bar i{background:var(--good)}
.comp-verdict{border:2px solid var(--rule);border-top:0;padding:24px 28px;display:flex;gap:20px;align-items:flex-start;background:var(--paper);flex-wrap:wrap}
.placar{flex:none;background:var(--ink);color:#fff;font-family:var(--mono);text-align:center;padding:14px 22px}
.placar b{display:block;font-size:1.7rem;color:var(--lime)}
.placar span{font-size:.64rem;letter-spacing:.18em}
.comp-verdict p{font-family:var(--serif);font-size:1.1rem;line-height:1.6;flex:1;min-width:240px}
.comp-cta{margin-top:24px;display:flex;gap:12px;flex-wrap:wrap}
.comp-pane{display:none}
.comp-pane.active{display:block}

/* ============ NOTÍCIAS ============ */
.news-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:44px}
.feat-news{text-decoration:none;display:block}
.feat-news .ph{aspect-ratio:16/9;border:1px solid var(--line)}
.feat-news h3{font-family:var(--serif);font-weight:900;font-size:clamp(1.4rem,2.6vw,2rem);line-height:1.15;margin:16px 0 10px}
.feat-news:hover h3{color:var(--accent)}
.feat-news p{color:var(--muted);font-size:.95rem}
.news-list{list-style:none;display:flex;flex-direction:column}
.news-list li{padding:20px 0;border-bottom:1px solid var(--line)}
.news-list li:first-child{padding-top:0}
.news-list a{text-decoration:none;display:block}
.news-list a:hover h4{color:var(--accent)}
.news-list h4{font-family:var(--serif);font-size:1.14rem;line-height:1.35;margin:7px 0 6px;font-weight:700}
.news-list p{font-size:.86rem;color:var(--muted)}
.ntime{font-family:var(--mono);font-size:.68rem;font-weight:700;letter-spacing:.12em;color:var(--accent)}

/* ============ LABORATÓRIO ============ */
.labsec{background:var(--ink);color:#E8EDF4}
.labsec .kicker{color:var(--lime)}
.labsec h2{font-family:var(--serif);font-weight:900;font-size:clamp(1.8rem,3.4vw,2.7rem);line-height:1.1;margin:12px 0 14px;color:#fff}
.labsec .intro{color:#A9B4C4;max-width:36rem;font-size:1.02rem}
.lab-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:56px;margin-top:38px;align-items:start}
.lab-photo .ph{aspect-ratio:4/4.6;border:1px solid #26334d}
.rig{border:1px solid #26334d;border-top:0;padding:18px 20px;font-family:var(--mono);font-size:.74rem;line-height:2;color:#9FB0C6}
.rig b{color:var(--lime);letter-spacing:.15em;font-size:.66rem;display:block;margin-bottom:6px}
.rig .ok{color:var(--lime)}
ol.steps{list-style:none;margin-top:6px}
ol.steps li{display:grid;grid-template-columns:64px 1fr;gap:18px;padding:22px 0;border-bottom:1px solid #26334d}
ol.steps li:first-child{border-top:1px solid #26334d}
ol.steps .n{font-family:var(--mono);font-weight:700;color:var(--lime);font-size:.85rem;padding-top:4px}
ol.steps h3{font-family:var(--serif);font-size:1.25rem;color:#fff;margin-bottom:6px}
ol.steps p{font-size:.92rem;color:#A9B4C4}
blockquote.pull{margin-top:30px;border-left:4px solid var(--lime);padding:6px 0 6px 24px;font-family:var(--serif);font-style:italic;font-size:1.25rem;line-height:1.5;color:#fff}
blockquote.pull footer{font-family:var(--sans);font-style:normal;font-size:.82rem;color:#8b98ac;margin-top:12px}
blockquote.pull footer b{color:var(--lime)}

/* ============ NEWSLETTER ============ */
.nl{border:2px solid var(--rule);padding:52px 40px;text-align:center;max-width:760px;margin:0 auto}
.nl h2{font-family:var(--serif);font-weight:900;font-size:clamp(1.5rem,3vw,2.1rem);margin:10px 0 12px}
.nl p{color:var(--muted);max-width:30rem;margin:0 auto 26px;font-size:.95rem}
.nl-form{display:flex;gap:0;max-width:26rem;margin:0 auto}
.nl-form input{flex:1;min-width:0;padding:14px 18px;border:2px solid var(--rule);border-right:0;font-size:.95rem;font-family:inherit;background:var(--paper);color:var(--text)}
.nl-form input:focus{outline:none;border-color:var(--accent)}
.nl-form button{border-radius:0}
.nl-ok{display:none;margin-top:14px;font-weight:700;color:var(--good)}
.nl small{display:block;margin-top:14px;color:var(--faint);font-size:.75rem}

/* ============ CONTEÚDO (posts/páginas) ============ */
.page-head{padding:52px 0 10px}
.page-head h1{font-family:var(--serif);font-weight:900;font-size:clamp(2rem,4vw,3rem);line-height:1.08;letter-spacing:-.015em;margin-top:12px}
.page-head .sub{color:var(--muted);margin-top:10px;max-width:40rem}
.entry-content{font-size:1.04rem;line-height:1.75;max-width:46rem;overflow-wrap:break-word}
.entry-content p,.entry-content ul,.entry-content ol{margin-bottom:1.3em}
.entry-content h2{font-family:var(--serif);font-weight:900;font-size:1.7rem;margin:1.6em 0 .6em;line-height:1.25}
.entry-content h3{font-family:var(--serif);font-weight:700;font-size:1.35rem;margin:1.4em 0 .5em}
.entry-content a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
.entry-content ul,.entry-content ol{padding-left:1.4em}
.entry-content li{margin-bottom:.5em}
.entry-content blockquote{border-left:4px solid var(--lime);padding:4px 0 4px 22px;font-family:var(--serif);font-style:italic;font-size:1.2rem;margin:1.6em 0}
.entry-content img{border:1px solid var(--line)}
.entry-content figure{margin:1.8em 0}
.entry-content figcaption{font-size:.8rem;color:var(--faint);margin-top:8px}
.entry-content table{width:100%;border-collapse:collapse;margin:1.6em 0;font-size:.92rem}
.entry-content th,.entry-content td{border:1px solid var(--line);padding:10px 14px;text-align:left}
.entry-content th{background:var(--wash);font-family:var(--mono);font-size:.75rem;letter-spacing:.06em}
.entry-content code{font-family:var(--mono);font-size:.85em;background:var(--wash);padding:2px 7px}
.entry-content pre{background:var(--ink);color:#E8EDF4;padding:20px;overflow-x:auto;font-size:.85rem}
.entry-content pre code{background:none;padding:0}
.alignleft{float:left;margin:0 1.4em 1em 0}
.alignright{float:right;margin:0 0 1em 1.4em}
.aligncenter{display:block;margin-left:auto;margin-right:auto}
.wp-caption{max-width:100%}
.wp-caption-text{font-size:.8rem;color:var(--faint);margin-top:8px}
.sticky,.gallery-caption,.bypostauthor{position:static}
.post-nav{display:flex;justify-content:space-between;gap:16px;border-top:2px solid var(--rule);margin-top:48px;padding-top:24px;flex-wrap:wrap}
.post-nav a{text-decoration:none;font-weight:600}
.post-nav a:hover{color:var(--accent)}
.post-nav span{display:block;font-family:var(--mono);font-size:.66rem;letter-spacing:.2em;color:var(--muted);margin-bottom:6px}
.pagination{margin-top:40px;display:flex;gap:8px;flex-wrap:wrap}
.pagination .page-numbers{border:2px solid var(--rule);padding:8px 16px;text-decoration:none;font-weight:700;font-size:.85rem}
.pagination .page-numbers.current{background:var(--ink);color:var(--lime);border-color:var(--ink)}
.author-box{display:flex;gap:18px;border:2px solid var(--rule);padding:26px;margin-top:44px;align-items:flex-start}
.author-box .avatar{width:60px;height:60px;font-size:1rem}
.author-box h3{font-family:var(--serif);font-size:1.2rem;margin-bottom:6px}
.author-box p{font-size:.9rem;color:var(--muted)}
.related{margin-top:56px}
.related h2{font-family:var(--serif);font-weight:900;font-size:1.6rem;margin-bottom:6px}
.search-form{display:flex;max-width:26rem;margin-top:18px}
.search-form input[type="search"]{flex:1;min-width:0;padding:12px 16px;border:2px solid var(--rule);border-right:0;font-family:inherit;font-size:.92rem}
.search-form input[type="submit"]{background:var(--ink);color:#fff;border:0;padding:0 22px;font-weight:700;cursor:pointer;font-family:inherit}

/* ============ 404 ============ */
.e404{text-align:center;padding:90px 0}
.e404 .big{font-family:var(--serif);font-weight:900;font-size:clamp(4rem,12vw,8rem);line-height:1}
.e404 h1{font-family:var(--serif);font-size:1.8rem;margin:10px 0}
.e404 p{color:var(--muted);margin-bottom:24px}

/* ============ FOOTER ============ */
footer.site-footer{background:#070C16;color:#8b98ac;padding:60px 0 28px;font-size:.9rem}
.foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:36px;margin-bottom:44px}
.foot-grid h4{color:#fff;font-family:var(--mono);font-size:.7rem;letter-spacing:.22em;margin-bottom:16px}
.foot-grid ul{list-style:none;display:flex;flex-direction:column;gap:11px}
.foot-grid a{text-decoration:none}
.foot-grid a:hover{color:var(--lime)}
.foot-brand{font-family:var(--grot);font-weight:700;font-size:1.5rem;color:#fff}
.foot-brand em{font-style:normal;color:var(--accent)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:22px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.78rem}

/* ============ RESPONSIVO ============ */
@media(max-width:980px){
  .hero-grid,.lab-grid,.news-grid{grid-template-columns:1fr;gap:36px}
  .masthead .wrap{flex-wrap:wrap}
  .week-score{display:none}
  .review-row{grid-template-columns:1fr;gap:18px}
  .scorebox{display:flex;align-items:center;gap:12px;justify-content:flex-start}
  .foot-grid{grid-template-columns:1fr 1fr}
  .stamp{left:auto;right:14px;bottom:-40px;width:110px;height:110px}
  .hero-photo{margin-bottom:30px}
}
@media(max-width:680px){
  .mainnav ul.links,.mainnav ul.menu{position:fixed;inset:0 0 auto 0;background:var(--paper);flex-direction:column;padding:84px 28px 28px;gap:6px;display:none;border-bottom:2px solid var(--rule);z-index:80}
  .mainnav ul.links.open,.mainnav ul.menu.open{display:flex}
  .mainnav ul.links a,.mainnav ul.menu a{padding:13px 0;border-bottom:1px solid var(--line);font-size:1.05rem}
  .hamburger{display:block}
  .mainnav .btn{display:none}
  .verdict-strip{grid-template-columns:1fr}
  .verdict-strip>div+div{border-left:0;border-top:2px solid var(--rule)}
  .utility nav ul li:not(:first-child){display:none}
  section.block{padding:52px 0}
  .nl{padding:38px 22px}
  .nl-form{flex-direction:column;gap:10px}
  .nl-form input{border-right:2px solid var(--rule)}
  .foot-grid{grid-template-columns:1fr}
  .author-box{flex-direction:column}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .stamp svg,.tick-label i{animation:none}
  .meter .fill,.bar i{transition:none}
  #tick-text{transition:none}
}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

/* ============ KIT AFILIADO ============ */
.disclosure{font-size:.78rem;color:var(--muted);background:var(--wash);border-left:3px solid var(--accent);padding:10px 14px;margin:18px 0 0;max-width:46rem}
.price-chip{display:inline-block;font-family:var(--mono);font-weight:700;font-size:.95rem;background:var(--ink);color:var(--lime);padding:8px 16px;margin-top:16px}
.buybox{border:2px solid var(--rule);margin-top:34px;background:var(--paper)}
.buybox h3{font-family:var(--mono);font-size:.72rem;letter-spacing:.22em;padding:20px 24px 0}
.buy-note{font-size:.82rem;color:var(--muted);padding:8px 24px 0}
.buyrow{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:16px 24px;border-top:1px solid var(--line);margin-top:14px;flex-wrap:wrap}
.buyrow strong{display:block;font-size:1rem}
.buyprice{font-family:var(--mono);font-weight:700;font-size:1.15rem;margin-right:10px}
.best-tag{display:inline-block;font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.14em;color:#1a2e05;background:var(--lime);padding:3px 10px;vertical-align:3px;white-space:nowrap}
.buyrow.best{background:var(--lime-soft)}
.sticky-buy{position:fixed;left:0;right:0;bottom:0;z-index:70;background:var(--ink);color:#fff;transform:translateY(110%);transition:transform .3s;box-shadow:0 -8px 30px rgba(0,0,0,.3)}
.sticky-buy.show{transform:none}
.sticky-buy .wrap{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-top:12px;padding-bottom:12px}
.sb-info{min-width:0}
.sb-info strong{display:block;font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:58vw}
.sb-info span{font-family:var(--mono);font-size:.7rem;color:var(--lime)}
body.has-sticky{padding-bottom:78px}
.comp-buy{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 0}
.cmp-wrap{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin:26px 0}
.cmp-wrap label{font-family:var(--mono);font-size:.66rem;font-weight:700;letter-spacing:.18em;color:var(--muted);display:block;margin-bottom:8px}
.cmp-wrap select{width:100%;padding:13px 14px;border:2px solid var(--rule);font-family:inherit;font-size:.92rem;background:var(--paper);color:var(--text)}
.cmp-msg{border:2px solid var(--rule);padding:26px;text-align:center;color:var(--muted);font-size:.95rem}
@media(max-width:680px){.cmp-wrap{grid-template-columns:1fr}.sb-info strong{max-width:44vw}}

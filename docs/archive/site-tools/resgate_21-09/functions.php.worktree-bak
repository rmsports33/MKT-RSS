		<label for="conexo_lede"><?php esc_html_e( 'Lede (resumo de abertura)', 'conexotech' ); ?></label>
		<textarea id="conexo_lede" name="conexo_lede" rows="2"><?php echo esc_textarea( $lede ); ?></textarea>
	</div>
	<div class="conexo-field" style="display:flex;gap:16px;flex-wrap:wrap">
		<div style="flex:1;min-width:200px">
			<label for="conexo_amostra"><?php esc_html_e( 'Código interno (opcional, ex.: S26U-041)', 'conexotech' ); ?></label>
			<input type="text" id="conexo_amostra" name="conexo_amostra" value="<?php echo esc_attr( $amostra ); ?>">

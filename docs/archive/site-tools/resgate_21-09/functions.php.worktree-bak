/* --- Meta box: Onde comprar (até 3 lojas no review) --- */
function conexo_lojas_boxes() {
	add_meta_box( 'conexo_lojas', __( 'Onde comprar (afiliados)', 'conexotech' ), 'conexo_lojas_box_html', 'review', 'normal', 'default' );
}
add_action( 'add_meta_boxes', 'conexo_lojas_boxes' );

function conexo_lojas_box_html( $post ) {
	wp_nonce_field( 'conexo_lojas_save', 'conexo_lojas_nonce' );
	?>
	<p style="color:#646970"><?php esc_html_e( 'Preencha até 3 lojas com seus links de afiliado. O preço é digitado por você (ex.: R$ 8.499) — confira e atualize 1–2x por semana. Deixe em branco o que não usar.', 'conexotech' ); ?></p>
	<?php
	for ( $i = 1; $i <= 3; $i++ ) :
		$nome  = get_post_meta( $post->ID, '_conexo_loja_' . $i . '_nome', true );
		$url   = get_post_meta( $post->ID, '_conexo_loja_' . $i . '_url', true );
		$preco = get_post_meta( $post->ID, '_conexo_loja_' . $i . '_preco', true );
		?>
		<div style="border:1px solid #c3c4c7;padding:12px;margin-bottom:12px;background:#f6f7f7">
			<strong><?php echo esc_html__( 'Loja ', 'conexotech' ) . esc_html( $i ); ?></strong>
			<p><label><?php esc_html_e( 'Nome da loja', 'conexotech' ); ?><br><input type="text" name="conexo_loja_<?php echo esc_attr( $i ); ?>_nome" value="<?php echo esc_attr( $nome ); ?>" style="width:100%" placeholder="Amazon"></label></p>
			<p><label><?php esc_html_e( 'Link de afiliado (URL completa)', 'conexotech' ); ?><br><input type="url" name="conexo_loja_<?php echo esc_attr( $i ); ?>_url" value="<?php echo esc_attr( $url ); ?>" style="width:100%" placeholder="https://..."></label></p>
			<p><label><?php esc_html_e( 'Preço exibido', 'conexotech' ); ?><br><input type="text" name="conexo_loja_<?php echo esc_attr( $i ); ?>_preco" value="<?php echo esc_attr( $preco ); ?>" placeholder="R$ 8.499"></label></p>
		</div>
		<?php
	endfor;
}

function conexo_lojas_save( $post_id ) {
	if ( ! isset( $_POST['conexo_lojas_nonce'] ) || ! wp_verify_nonce( sanitize_key( $_POST['conexo_lojas_nonce'] ), 'conexo_lojas_save' ) ) {
		return;
	}
	if ( defined( 'DOING_AUTOSAVE' ) && DOING_AUTOSAVE ) {
		return;
	}
	if ( ! current_user_can( 'edit_post', $post_id ) || get_post_type( $post_id ) !== 'review' ) {
		return;
	}
	for ( $i = 1; $i <= 3; $i++ ) {
		$nk = 'conexo_loja_' . $i . '_nome';
		$uk = 'conexo_loja_' . $i . '_url';
		$pk = 'conexo_loja_' . $i . '_preco';
		update_post_meta( $post_id, '_conexo_loja_' . $i . '_nome', isset( $_POST[ $nk ] ) ? sanitize_text_field( wp_unslash( $_POST[ $nk ] ) ) : '' );
		update_post_meta( $post_id, '_conexo_loja_' . $i . '_url', isset( $_POST[ $uk ] ) ? esc_url_raw( wp_unslash( $_POST[ $uk ] ) ) : '' );
		update_post_meta( $post_id, '_conexo_loja_' . $i . '_preco', isset( $_POST[ $pk ] ) ? sanitize_text_field( wp_unslash( $_POST[ $pk ] ) ) : '' );
	}
}
add_action( 'save_post', 'conexo_lojas_save' );

/* --- Meta box: links de compra por produto (comparativo) --- */
function conexo_comp_links_boxes() {
	add_meta_box( 'conexo_comp_links', __( 'Links de compra (afiliados)', 'conexotech' ), 'conexo_comp_links_box_html', 'comparativo', 'normal', 'default' );
}
add_action( 'add_meta_boxes', 'conexo_comp_links_boxes' );

function conexo_comp_links_box_html( $post ) {
	wp_nonce_field( 'conexo_comp_links_save', 'conexo_comp_links_nonce' );
	?>
	<p style="color:#646970"><?php esc_html_e( 'Um link de afiliado para cada produto do comparativo (o botão "Ver preço" aparece na tabela).', 'conexotech' ); ?></p>
	<?php
	for ( $i = 1; $i <= 3; $i++ ) :
		$url = get_post_meta( $post->ID, '_conexo_buy_' . $i, true );
		?>
		<p><label><?php echo esc_html__( 'Link de compra — Produto ', 'conexotech' ) . esc_html( $i ); ?><br><input type="url" name="conexo_buy_<?php echo esc_attr( $i ); ?>" value="<?php echo esc_attr( $url ); ?>" style="width:100%" placeholder="https://..."></label></p>
		<?php
	endfor;
}

function conexo_comp_links_save( $post_id ) {
	if ( ! isset( $_POST['conexo_comp_links_nonce'] ) || ! wp_verify_nonce( sanitize_key( $_POST['conexo_comp_links_nonce'] ), 'conexo_comp_links_save' ) ) {
		return;
	}
	if ( defined( 'DOING_AUTOSAVE' ) && DOING_AUTOSAVE ) {
		return;
	}
	if ( ! current_user_can( 'edit_post', $post_id ) || get_post_type( $post_id ) !== 'comparativo' ) {
		return;
	}
	for ( $i = 1; $i <= 3; $i++ ) {
		$k = 'conexo_buy_' . $i;
		update_post_meta( $post_id, '_conexo_buy_' . $i, isset( $_POST[ $k ] ) ? esc_url_raw( wp_unslash( $_POST[ $k ] ) ) : '' );
	}
}
add_action( 'save_post', 'conexo_comp_links_save' );

/* --- Lojas de um review (só as preenchidas) --- */
function conexo_lojas( $post_id = null ) {
	$post_id = $post_id ? $post_id : get_the_ID();
	$lojas   = array();
	for ( $i = 1; $i <= 3; $i++ ) {
		$url = get_post_meta( $post_id, '_conexo_loja_' . $i . '_url', true );
		if ( ! $url ) {
			continue;
		}
		$lojas[] = array(
			'nome'  => get_post_meta( $post_id, '_conexo_loja_' . $i . '_nome', true ),
			'url'   => $url,
			'preco' => get_post_meta( $post_id, '_conexo_loja_' . $i . '_preco', true ),
		);
	}
	return $lojas;
}

/* --- Menor preço entre as lojas (para o selo) --- */
function conexo_menor_preco( $lojas ) {
	$best = null;
	foreach ( (array) $lojas as $l ) {
		$raw = preg_replace( '/[^\d.,]/', '', (string) $l['preco'] );
		if ( $raw === '' ) {
			continue;
		}
		$n = (float) str_replace( ',', '.', str_replace( '.', '', $raw ) );
		if ( $n <= 0 ) {
			continue;
		}
		if ( null === $best || $n < $best['num'] ) {
			$best = array( 'num' => $n, 'loja' => $l );
		}
	}
	return $best;
}

/* --- Link de afiliado com atributos corretos (SEO + segurança) --- */
function conexo_aff( $url, $label, $class = 'btn btn-ink' ) {
	if ( ! $url ) {
		return '';
	}
	return '<a class="' . esc_attr( $class ) . '" href="' . esc_url( $url ) . '" target="_blank" rel="sponsored nofollow noopener">' . esc_html( $label ) . '</a>';
}

/* --- Schema.org Review (estrelas nos resultados do Google) --- */
function conexo_jsonld() {
	if ( ! is_singular( 'review' ) ) {
		return;
	}
	$id       = get_the_ID();
	$nota_raw = str_replace( ',', '.', (string) conexo_nota( $id ) );
	$post     = get_post( $id );
	$author_name = $post ? get_the_author_meta( 'display_name', $post->post_author ) : get_bloginfo( 'name' );
	$has_rating  = is_numeric( $nota_raw ) && (float) $nota_raw > 0;
	$rating      = array(
		'@type'       => 'Rating',
		'ratingValue' => (float) $nota_raw,
		'bestRating'  => 10,
		'worstRating' => 0,
	);
	$product = array(
		'@type' => 'Product',
		'name'  => get_the_title( $id ),
	);
	if ( has_post_thumbnail( $id ) ) {
		$img = wp_get_attachment_image_src( get_post_thumbnail_id( $id ), 'conexo-wide' );
		if ( $img ) {
			$product['image'] = $img[0];
		}
	}
	/* O Google exige que todo Product tenha offers, review ou
	 * aggregateRating — por isso aninhamos o review no produto. */
	if ( $has_rating ) {
		$product['review'] = array(
			'@type'         => 'Review',
			'author'        => array(
				'@type' => 'Person',
				'name'  => $author_name,
			),
			'datePublished' => get_the_date( 'c', $id ),
			'reviewRating'  => $rating,
		);
	}
	$data = array(
		'@context'      => 'https://schema.org',
		'@type'         => 'Review',
		'itemReviewed'  => $product,
		'author'        => array(
			'@type' => 'Person',
			'name'  => $author_name,
		),
		'datePublished' => get_the_date( 'c', $id ),
		'reviewBody'    => has_excerpt( $id ) ? get_the_excerpt( $id ) : '',
	);
	if ( $has_rating ) {
		$data['reviewRating'] = $rating;
	}
	if ( isset( $product['image'] ) ) {
		$data['image'] = $product['image'];
	}
	echo '<script type="application/ld+json">' . wp_json_encode( $data, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n"; // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
}
add_action( 'wp_head', 'conexo_jsonld' );

/* ============================================================
 * 9. FASE B — Shortcode de rankings [conexo_ranking]
 * Uso na página: [conexo_ranking tipo="smartphones" qtd="7"]
 * "tipo" é o slug da categoria (Reviews → Categorias de produto).
 * ============================================================ */
function conexo_ranking_shortcode( $atts ) {
	$a   = shortcode_atts( array( 'tipo' => '', 'qtd' => 5 ), $atts, 'conexo_ranking' );
	$qtd = max( 1, min( 20, (int) $a['qtd'] ) );
	$args = array(
		'post_type'      => 'review',
		'posts_per_page' => $qtd,
		'post_status'    => 'publish',
		'meta_key'       => '_conexo_nota',
		'orderby'        => 'meta_value_num',
		'order'          => 'DESC',
		'meta_query'     => array( array( 'key' => '_conexo_nota', 'value' => '', 'compare' => '!=' ) ),
	);
	if ( $a['tipo'] !== '' ) {
		$args['tax_query'] = array( array( 'taxonomy' => 'tipo_produto', 'field' => 'slug', 'terms' => sanitize_text_field( $a['tipo'] ) ) );
	}
	$q = new WP_Query( $args );
	if ( ! $q->have_posts() ) {
		return '<p>' . esc_html__( 'Ranking em construção — publique reviews com nota para vê-lo aqui.', 'conexotech' ) . '</p>';
	}
	ob_start();
	$pos = 1;
	while ( $q->have_posts() ) {
		$q->the_post();
		$lojas = conexo_lojas();
		$first = $lojas ? $lojas[0] : null;
		$selo  = '';
		if ( 1 === $pos ) {
			$selo = __( 'ESCOLHA CONEXOTECH', 'conexotech' );
		} elseif ( 2 === $pos ) {
			$selo = __( 'CUSTO-BENEFÍCIO', 'conexotech' );
		}
		?>
		<article class="review-row" style="grid-template-columns:64px 200px 1fr auto">
			<span style="font-family:var(--serif);font-weight:900;font-size:2.4rem;line-height:1;color:var(--line)"><?php echo esc_html( sprintf( '%02d', $pos ) ); ?></span>
			<?php echo conexo_thumb( 'conexo-mini', 'CT' ); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?>
			<div>
				<?php if ( $selo ) : ?><span class="best-tag"><?php echo esc_html( $selo ); ?></span><?php endif; ?>
				<h3 style="font-size:1.2rem;margin:6px 0 8px"><a href="<?php the_permalink(); ?>"><?php the_title(); ?></a></h3>
				<p style="font-size:.88rem"><?php echo wp_kses_post( get_the_excerpt() ); ?></p>
				<?php if ( $first ) : ?>
				<div style="margin-top:12px"><?php echo conexo_aff( $first['url'], sprintf( __( 'Ver preço%s', 'conexotech' ), $first['preco'] ? ': ' . $first['preco'] : '' ), 'btn btn-ink btn-sm' ); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?></div>
				<?php endif; ?>
			</div>
			<?php if ( conexo_nota() ) : ?>
			<div class="scorebox<?php echo 1 === $pos ? ' gold' : ''; ?>"><b><?php echo esc_html( conexo_nota() ); ?></b><span><?php esc_html_e( 'NOTA', 'conexotech' ); ?></span></div>
			<?php endif; ?>
		</article>
		<?php
		$pos++;
	}
	wp_reset_postdata();
	return ob_get_clean();
}
add_shortcode( 'conexo_ranking', 'conexo_ranking_shortcode' );

/* ============================================================
 * 10. API REST — libera ficha e categoria para automação
 * Permite publicar reviews/comparativos COMPLETOS via API
 * (nota, specs, lojas, categoria) com senha de aplicativo.
 * Leitura pública; escrita só para quem pode publicar.
 * ============================================================ */
function conexo_rest_auth() {
	return current_user_can( 'edit_posts' );
}

function conexo_register_rest_meta() {
	$review_keys = array(
		'_conexo_nota', '_conexo_lede', '_conexo_amostra', '_conexo_tempo',
		'_conexo_veredito', '_conexo_pros', '_conexo_contras', '_conexo_specs',
		'_conexo_benchs', '_conexo_destaque',
		'_conexo_loja_1_nome', '_conexo_loja_1_url', '_conexo_loja_1_preco',
		'_conexo_loja_2_nome', '_conexo_loja_2_url', '_conexo_loja_2_preco',
		'_conexo_loja_3_nome', '_conexo_loja_3_url', '_conexo_loja_3_preco',
	);
	foreach ( $review_keys as $key ) {
		register_meta( 'post', $key, array(
			'object_subtype' => 'review',
			'type'           => 'string',
			'single'         => true,
			'show_in_rest'   => true,
			'auth_callback'  => 'conexo_rest_auth',
		) );
	}
	$comp_keys = array(
		'_conexo_prod_1', '_conexo_prod_2', '_conexo_prod_3',
		'_conexo_nota_1', '_conexo_nota_2', '_conexo_nota_3',
		'_conexo_comp_veredito',
		'_conexo_buy_1', '_conexo_buy_2', '_conexo_buy_3',
	);
	for ( $r = 1; $r <= 6; $r++ ) {
		$comp_keys[] = '_conexo_crit_' . $r . '_label';
		$comp_keys[] = '_conexo_crit_' . $r . '_v1';
		$comp_keys[] = '_conexo_crit_' . $r . '_v2';
		$comp_keys[] = '_conexo_crit_' . $r . '_v3';
		$comp_keys[] = '_conexo_crit_' . $r . '_win';
	}
	foreach ( $comp_keys as $key ) {
		register_meta( 'post', $key, array(
			'object_subtype' => 'comparativo',
			'type'           => 'string',
			'single'         => true,
			'show_in_rest'   => true,
			'auth_callback'  => 'conexo_rest_auth',
		) );
	}
}
add_action( 'init', 'conexo_register_rest_meta' );

/* ============================================================
 * 10b. API REST — campo ficha (mecanismo direto, sem falha muda)
 * Expõe TODOS os campos da ficha num único campo `conexo_ficha`
 * (objeto), com leitura e escrita explícitas. Leitura pública;
 * escrita só para quem pode editar o post.
 * ============================================================ */
function conexo_ficha_keys( $post_type = 'review' ) {
	if ( 'comparativo' === $post_type ) {
		$keys = array(
			'_conexo_prod_1', '_conexo_prod_2', '_conexo_prod_3',
			'_conexo_nota_1', '_conexo_nota_2', '_conexo_nota_3',
			'_conexo_comp_veredito',
			'_conexo_buy_1', '_conexo_buy_2', '_conexo_buy_3',
		);
		for ( $r = 1; $r <= 6; $r++ ) {
			$keys[] = '_conexo_crit_' . $r . '_label';
			$keys[] = '_conexo_crit_' . $r . '_v1';
			$keys[] = '_conexo_crit_' . $r . '_v2';
			$keys[] = '_conexo_crit_' . $r . '_v3';
			$keys[] = '_conexo_crit_' . $r . '_win';
		}
		return $keys;
	}
	return array(
		'_conexo_nota', '_conexo_lede', '_conexo_amostra', '_conexo_tempo',
		'_conexo_veredito', '_conexo_pros', '_conexo_contras', '_conexo_specs',
		'_conexo_benchs', '_conexo_destaque',
		'_conexo_loja_1_nome', '_conexo_loja_1_url', '_conexo_loja_1_preco',
		'_conexo_loja_2_nome', '_conexo_loja_2_url', '_conexo_loja_2_preco',
		'_conexo_loja_3_nome', '_conexo_loja_3_url', '_conexo_loja_3_preco',
	);
}

function conexo_ficha_get( $object ) {
	$id  = isset( $object['id'] ) ? (int) $object['id'] : 0;
	$out = array();
	if ( ! $id ) {
		return $out;
	}
	foreach ( conexo_ficha_keys( get_post_type( $id ) ) as $k ) {
		$out[ $k ] = get_post_meta( $id, $k, true );
	}
	return $out;
}

function conexo_ficha_update( $value, $object ) {
	$pid = $object instanceof WP_Post ? $object->ID : 0;
	if ( ! $pid || ! is_array( $value ) ) {
		return false;
	}
	if ( ! current_user_can( 'edit_post', $pid ) ) {
		return new WP_Error( 'conexo_forbidden', __( 'Sem permissão.', 'conexotech' ), array( 'status' => 403 ) );
	}
	foreach ( conexo_ficha_keys( get_post_type( $pid ) ) as $k ) {
		if ( array_key_exists( $k, $value ) ) {
			$v = $value[ $k ];
			if ( substr( $k, -4 ) === '_url' ) {
				update_post_meta( $pid, $k, esc_url_raw( $v ) );
			} else {
				update_post_meta( $pid, $k, sanitize_textarea_field( (string) $v ) );
			}
		}
	}
	return true;
}

function conexo_register_rest_ficha() {
	$args = array(
		'get_callback'    => 'conexo_ficha_get',
		'update_callback' => 'conexo_ficha_update',
		'schema'          => array(
			'type'        => 'object',
			'description' => __( 'Ficha do review/comparativo (ConexoTech).', 'conexotech' ),
		),
	);
	register_rest_field( 'review', 'conexo_ficha', $args );
	register_rest_field( 'comparativo', 'conexo_ficha', $args );
}
add_action( 'rest_api_init', 'conexo_register_rest_ficha' );

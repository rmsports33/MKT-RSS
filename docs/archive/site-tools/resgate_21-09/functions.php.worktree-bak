function conexo_review_save( $post_id ) {
	if ( ! isset( $_POST['conexo_review_nonce'] ) || ! wp_verify_nonce( sanitize_key( $_POST['conexo_review_nonce'] ), 'conexo_review_save' ) ) {
		return;
	}
	if ( defined( 'DOING_AUTOSAVE' ) && DOING_AUTOSAVE ) {
		return;
	}
	if ( ! current_user_can( 'edit_post', $post_id ) || get_post_type( $post_id ) !== 'review' ) {
		return;
	}
	$nota_raw = isset( $_POST['conexo_nota'] ) ? sanitize_text_field( wp_unslash( $_POST['conexo_nota'] ) ) : '';
	$nota     = (float) str_replace( ',', '.', $nota_raw );
	$nota     = max( 0, min( 10, $nota ) );
	update_post_meta( $post_id, '_conexo_nota', $nota > 0 ? number_format( $nota, 1, ',', '' ) : '' );

	$text_fields = array( 'lede', 'amostra', 'tempo' );
	foreach ( $text_fields as $f ) {
		$key = 'conexo_' . $f;
		update_post_meta( $post_id, '_conexo_' . $f, isset( $_POST[ $key ] ) ? sanitize_text_field( wp_unslash( $_POST[ $key ] ) ) : '' );
	}
	$area_fields = array( 'veredito', 'pros', 'contras', 'specs', 'benchs' );
	foreach ( $area_fields as $f ) {
		$key = 'conexo_' . $f;
		update_post_meta( $post_id, '_conexo_' . $f, isset( $_POST[ $key ] ) ? sanitize_textarea_field( wp_unslash( $_POST[ $key ] ) ) : '' );
	}
	update_post_meta( $post_id, '_conexo_destaque', isset( $_POST['conexo_destaque'] ) ? '1' : '0' );
}
add_action( 'save_post', 'conexo_review_save' );

/* ============================================================
 * 4. META BOXES — COMPARATIVO
 * 3 produtos + notas + 6 critérios (rótulo, 3 valores, vencedor).
 * ============================================================ */
function conexo_comp_boxes() {

	$prods   = array();
	$notas   = array();
	for ( $i = 1; $i <= 3; $i++ ) {
		$prods[ $i ] = get_post_meta( $post->ID, '_conexo_prod_' . $i, true );
		$notas[ $i ] = get_post_meta( $post->ID, '_conexo_nota_' . $i, true );
	}
	$veredito = get_post_meta( $post->ID, '_conexo_comp_veredito', true );
	?>
	<style>.conexo-field{margin-bottom:14px}.conexo-field label{display:block;font-weight:600;margin-bottom:4px}.conexo-field input[type=text]{width:100%}.conexo-grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.conexo-crit{border:1px solid #c3c4c7;padding:12px;margin-bottom:12px;background:#f6f7f7}.conexo-crit h4{margin:0 0 8px}</style>
	<div class="conexo-field">
		<label><?php esc_html_e( 'Produtos (nome de cada coluna)', 'conexotech' ); ?></label>
		<div class="conexo-grid3">
			<?php for ( $i = 1; $i <= 3; $i++ ) : ?>
				<input type="text" name="conexo_prod_<?php echo esc_attr( $i ); ?>" value="<?php echo esc_attr( $prods[ $i ] ); ?>" placeholder="<?php echo esc_attr__( 'Produto ', 'conexotech' ) . esc_attr( $i ); ?>">
			<?php endfor; ?>
		</div>
	</div>
	<div class="conexo-field">
		<label><?php esc_html_e( 'Notas finais (0 a 10)', 'conexotech' ); ?></label>
		<div class="conexo-grid3">
			<?php for ( $i = 1; $i <= 3; $i++ ) : ?>
				<input type="text" name="conexo_nota_<?php echo esc_attr( $i ); ?>" value="<?php echo esc_attr( $notas[ $i ] ); ?>" placeholder="9,0" style="max-width:120px">
			<?php endfor; ?>
		</div>
	</div>
	<?php for ( $r = 1; $r <= 6; $r++ ) :
		$label = get_post_meta( $post->ID, '_conexo_crit_' . $r . '_label', true );
		$win   = get_post_meta( $post->ID, '_conexo_crit_' . $r . '_win', true );
		?>
		<div class="conexo-crit">
			<h4><?php echo esc_html__( 'Critério ', 'conexotech' ) . esc_html( $r ); ?></h4>
			<div class="conexo-field">
				<label><?php esc_html_e( 'Rótulo do critério', 'conexotech' ); ?></label>
				<input type="text" name="conexo_crit_<?php echo esc_attr( $r ); ?>_label" value="<?php echo esc_attr( $label ); ?>" placeholder="Ex.: Bateria (teste)">
			</div>
			<div class="conexo-grid3">
				<?php for ( $i = 1; $i <= 3; $i++ ) :
					$v = get_post_meta( $post->ID, '_conexo_crit_' . $r . '_v' . $i, true );
					?>
					<input type="text" name="conexo_crit_<?php echo esc_attr( $r ); ?>_v<?php echo esc_attr( $i ); ?>" value="<?php echo esc_attr( $v ); ?>" placeholder="<?php echo esc_attr__( 'Valor produto ', 'conexotech' ) . esc_attr( $i ); ?>">
				<?php endfor; ?>
			</div>
			<div class="conexo-field" style="margin-top:8px">
				<label><?php esc_html_e( 'Vencedor do critério', 'conexotech' ); ?></label>
				<select name="conexo_crit_<?php echo esc_attr( $r ); ?>_win">
					<option value="-1" <?php selected( $win, '-1' ); ?>><?php esc_html_e( 'Nenhum / empate', 'conexotech' ); ?></option>
					<option value="0" <?php selected( $win, '0' ); ?>><?php esc_html_e( 'Produto 1', 'conexotech' ); ?></option>
					<option value="1" <?php selected( $win, '1' ); ?>><?php esc_html_e( 'Produto 2', 'conexotech' ); ?></option>
					<option value="2" <?php selected( $win, '2' ); ?>><?php esc_html_e( 'Produto 3', 'conexotech' ); ?></option>
				</select>
			</div>
		</div>
	<?php endfor; ?>
	<div class="conexo-field">
		<label for="conexo_comp_veredito"><?php esc_html_e( 'Texto do veredito (placar calculado sozinho)', 'conexotech' ); ?></label>
		<textarea id="conexo_comp_veredito" name="conexo_comp_veredito" rows="3" style="width:100%"><?php echo esc_textarea( $veredito ); ?></textarea>

	<?php
}

function conexo_comp_save( $post_id ) {
	if ( ! isset( $_POST['conexo_comp_nonce'] ) || ! wp_verify_nonce( sanitize_key( $_POST['conexo_comp_nonce'] ), 'conexo_comp_save' ) ) {
		return;
	}
	if ( defined( 'DOING_AUTOSAVE' ) && DOING_AUTOSAVE ) {
		return;
	}
	if ( ! current_user_can( 'edit_post', $post_id ) || get_post_type( $post_id ) !== 'comparativo' ) {
		return;
	}
	for ( $i = 1; $i <= 3; $i++ ) {
		$pk = 'conexo_prod_' . $i;
		update_post_meta( $post_id, '_conexo_prod_' . $i, isset( $_POST[ $pk ] ) ? sanitize_text_field( wp_unslash( $_POST[ $pk ] ) ) : '' );
		$nk      = 'conexo_nota_' . $i;
		$nraw    = isset( $_POST[ $nk ] ) ? sanitize_text_field( wp_unslash( $_POST[ $nk ] ) ) : '';
		$n       = (float) str_replace( ',', '.', $nraw );
		$n       = max( 0, min( 10, $n ) );
		update_post_meta( $post_id, '_conexo_nota_' . $i, $n > 0 ? number_format( $n, 1, ',', '' ) : '' );
	}
	for ( $r = 1; $r <= 6; $r++ ) {
		$lk = 'conexo_crit_' . $r . '_label';
		update_post_meta( $post_id, '_conexo_crit_' . $r . '_label', isset( $_POST[ $lk ] ) ? sanitize_text_field( wp_unslash( $_POST[ $lk ] ) ) : '' );
		for ( $i = 1; $i <= 3; $i++ ) {
			$vk = 'conexo_crit_' . $r . '_v' . $i;
			update_post_meta( $post_id, '_conexo_crit_' . $r . '_v' . $i, isset( $_POST[ $vk ] ) ? sanitize_text_field( wp_unslash( $_POST[ $vk ] ) ) : '' );
		}
		$wk  = 'conexo_crit_' . $r . '_win';
		$win = isset( $_POST[ $wk ] ) ? intval( $_POST[ $wk ] ) : -1;
		if ( $win < -1 || $win > 2 ) {
			$win = -1;
		}
		update_post_meta( $post_id, '_conexo_crit_' . $r . '_win', (string) $win );
	}
	update_post_meta( $post_id, '_conexo_comp_veredito', isset( $_POST['conexo_comp_veredito'] ) ? sanitize_textarea_field( wp_unslash( $_POST['conexo_comp_veredito'] ) ) : '' );
}
add_action( 'save_post', 'conexo_comp_save' );

/* ============================================================
 * 5. ASSETS
 * ============================================================ */
function conexo_assets() {
	wp_enqueue_style( 'conexo-fonts', 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;0,8..60,900;1,8..60,600&family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;500;700&display=swap', array(), CONEXO_VERSION );
	wp_enqueue_style( 'conexo-style', get_stylesheet_uri(), array( 'conexo-fonts' ), CONEXO_VERSION );

	wp_enqueue_script( 'conexo-main', get_template_directory_uri() . '/assets/js/main.js', array(), CONEXO_VERSION, true );

	$ticks = array();
	$recent = new WP_Query( array( 'posts_per_page' => 4, 'post_status' => 'publish', 'ignore_sticky_posts' => true ) );
	while ( $recent->have_posts() ) {
		$recent->the_post();
		$ticks[] = get_the_title();
	}
	wp_reset_postdata();
	wp_localize_script( 'conexo-main', 'conexoTicks', $ticks );
}
add_action( 'wp_enqueue_scripts', 'conexo_assets' );

/* ============================================================
 * 6. HELPERS
 * ============================================================ */

/* Nota do review formatada (ex.: "9,2") */
function conexo_nota( $post_id = null ) {
	$post_id = $post_id ? $post_id : get_the_ID();
	return get_post_meta( $post_id, '_conexo_nota', true );
}

/* Review em destaque (checkbox) ou o mais recente */
function conexo_review_destaque() {
	$q = new WP_Query( array(
		'post_type'      => 'review',
		'posts_per_page' => 1,
		'post_status'    => 'publish',
		'meta_key'       => '_conexo_destaque',
		'meta_value'     => '1',
	) );
	if ( ! $q->have_posts() ) {
		$q = new WP_Query( array( 'post_type' => 'review', 'posts_per_page' => 1, 'post_status' => 'publish' ) );
	}
	return $q;
}

/* Primeiro termo da taxonomia (nome) */
function conexo_term_nome( $post_id = null, $taxonomy = 'tipo_produto' ) {
	$post_id = $post_id ? $post_id : get_the_ID();
	$terms = get_the_terms( $post_id, $taxonomy );
	if ( $terms && ! is_wp_error( $terms ) ) {
		return $terms[0]->name;
	}
	return '';
}

/* Primeiro termo (slug) — para filtros JS */
function conexo_term_slug( $post_id = null, $taxonomy = 'tipo_produto' ) {
	$post_id = $post_id ? $post_id : get_the_ID();
	$terms = get_the_terms( $post_id, $taxonomy );
	if ( $terms && ! is_wp_error( $terms ) ) {
		return $terms[0]->slug;
	}
	return 'geral';
}

/* Figura com foto destacada ou fallback elegante */
function conexo_thumb( $size = 'conexo-thumb', $ph = 'CT', $class = '' ) {
	$html = '<span class="ph ' . esc_attr( $class ) . '" data-ph="' . esc_attr( $ph ) . '" style="display:block">';
	if ( has_post_thumbnail() ) {
		$html .= get_the_post_thumbnail( get_the_ID(), $size, array( 'alt' => esc_attr( get_the_title() ) ) );
	}
	$html .= '</span>';
	return $html;
}

/* Iniciais do autor para o avatar */
function conexo_iniciais( $author_id = null ) {
	$author_id = $author_id ? $author_id : get_the_author_meta( 'ID' );
	$name  = get_the_author_meta( 'display_name', $author_id );
	$parts = preg_split( '/\s+/', trim( $name ) );
	$ini   = '';
	if ( ! empty( $parts[0] ) ) {
		$ini .= mb_strtoupper( mb_substr( $parts[0], 0, 1 ) );
	}
	if ( count( $parts ) > 1 ) {
		$ini .= mb_strtoupper( mb_substr( end( $parts ), 0, 1 ) );
	}
	return $ini ? $ini : 'CT';
}

/* Quebra textarea em linhas não vazias */
function conexo_linhas( $text ) {
	$lines = preg_split( '/\r\n|\r|\n/', (string) $text );
	return array_values( array_filter( array_map( 'trim', $lines ) ) );
}

/* Excerpt mais curto no tema */
function conexo_excerpt_length() {
	return 24;
}
add_filter( 'excerpt_length', 'conexo_excerpt_length' );

/* ============================================================
 * 7. FALLBACKS DE MENU (quando nenhum menu foi criado)
 * ============================================================ */
function conexo_primary_fallback() {

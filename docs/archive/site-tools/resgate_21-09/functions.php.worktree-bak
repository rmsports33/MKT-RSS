<?php
/**
 * ConexoTech — functions.php
 * Configuração do tema: CPTs, taxonomias, meta boxes, menus e assets.
 *
 * @package ConexoTech
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

define( 'CONEXO_VERSION', '1.3.0' );

/* ============================================================
 * 1. CONFIGURAÇÃO BASE
 * ============================================================ */
function conexo_setup() {
	add_theme_support( 'title-tag' );
	add_theme_support( 'post-thumbnails' );
	add_theme_support( 'html5', array( 'search-form', 'comment-form', 'comment-list', 'gallery', 'caption', 'style', 'script' ) );
	add_theme_support( 'custom-logo', array( 'height' => 88, 'width' => 300, 'flex-height' => true, 'flex-width' => true ) );
	add_theme_support( 'responsive-embeds' );

	add_image_size( 'conexo-thumb', 800, 525, true );   // lista de reviews
	add_image_size( 'conexo-wide', 1200, 675, true );   // destaque / notícias
	add_image_size( 'conexo-mini', 400, 400, true );    // ranking / comparativo

	register_nav_menus( array(
		'primary' => __( 'Navegação principal', 'conexotech' ),
		'utility' => __( 'Barra superior (institucional)', 'conexotech' ),
		'footer'  => __( 'Rodapé', 'conexotech' ),
	) );
}
add_action( 'after_setup_theme', 'conexo_setup' );

/* Termos padrão da taxonomia (criados uma vez) */
function conexo_default_terms() {
	$defaults = array( 'Smartphones', 'Notebooks', 'Áudio' );
	foreach ( $defaults as $name ) {
		if ( ! term_exists( $name, 'tipo_produto' ) ) {
			wp_insert_term( $name, 'tipo_produto' );
		}
	}
}

/* ============================================================
 * 2. TIPOS DE CONTEÚDO
 * ============================================================ */
function conexo_register_types() {

	/* --- Taxonomia compartilhada: categoria de produto --- */
	register_taxonomy( 'tipo_produto', array( 'review', 'comparativo', 'post' ), array(
		'labels' => array(
			'name'          => __( 'Categorias de produto', 'conexotech' ),
			'singular_name' => __( 'Categoria de produto', 'conexotech' ),
		),
		'hierarchical'      => true,
		'show_ui'           => true,
		'show_admin_column' => true,
		'show_in_rest'      => true,
		'rewrite'           => array( 'slug' => 'categoria' ),
	) );

	/* --- CPT: Reviews --- */
	register_post_type( 'review', array(
		'labels' => array(
			'name'          => __( 'Reviews', 'conexotech' ),
			'singular_name' => __( 'Review', 'conexotech' ),
			'add_new_item'  => __( 'Adicionar review', 'conexotech' ),
			'edit_item'     => __( 'Editar review', 'conexotech' ),
		),
		'public'       => true,
		'has_archive'  => true,
		'rewrite'      => array( 'slug' => 'reviews' ),
		'show_in_rest' => true,
		'menu_icon'    => 'dashicons-star-filled',
		'supports'     => array( 'title', 'editor', 'thumbnail', 'excerpt', 'author' ),
	) );

	/* --- CPT: Comparativos --- */
	register_post_type( 'comparativo', array(
		'labels' => array(
			'name'          => __( 'Comparativos', 'conexotech' ),
			'singular_name' => __( 'Comparativo', 'conexotech' ),
			'add_new_item'  => __( 'Adicionar comparativo', 'conexotech' ),
			'edit_item'     => __( 'Editar comparativo', 'conexotech' ),
		),
		'public'       => true,
		'has_archive'  => true,
		'rewrite'      => array( 'slug' => 'comparativos' ),
		'show_in_rest' => true,
		'menu_icon'    => 'dashicons-columns',
		'supports'     => array( 'title', 'editor', 'thumbnail', 'excerpt', 'author' ),
	) );

	conexo_default_terms();
}
add_action( 'init', 'conexo_register_types' );

/* Reescreve regras ao ativar o tema */
function conexo_activate() {
	conexo_register_types();
	flush_rewrite_rules();
}
add_action( 'after_switch_theme', 'conexo_activate' );

/* ============================================================
 * 3. META BOXES — REVIEW
 * Campos: nota, lede, amostra, tempo, destaque, prós, contras,
 * specs (linhas "Rótulo | Valor") e benchmarks ("Rótulo | Detalhe | 0-100").
 * ============================================================ */
function conexo_review_boxes() {
	add_meta_box( 'conexo_review', __( 'Ficha do review', 'conexotech' ), 'conexo_review_box_html', 'review', 'normal', 'high' );
}
add_action( 'add_meta_boxes', 'conexo_review_boxes' );


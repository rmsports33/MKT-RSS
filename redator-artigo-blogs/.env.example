# Copie para .env e preencha. Nunca commitar .env.
# Cadeia gratuita: OpenRouter (Gemini free, 600/dia) -> Groq (free) -> Ollama local (ilimitado)
# Dica: a chave GROQ_API_KEY do .env da RAIZ do projeto também vale (fallback automático).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-flash-1.5:free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
